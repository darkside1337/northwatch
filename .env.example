# Database (Neon Postgres connection string)
# NOTE: In production (Vercel serverless), ALWAYS use Neon's '-pooler' endpoint (PgBouncer transaction mode)
# e.g., postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=your-32-character-secret-key-here
BETTER_AUTH_URL=http://localhost:3000

# Stripe (Payments)
# Production recommendation: Use a Restricted API Key (rk_live_... / rk_test_...)
# Scoped strictly to: PaymentIntents (Read & Write), Refunds (Read & Write), Charges (Read), Webhooks (Read)
STRIPE_SECRET_KEY=sk_test_... # or rk_test_... / rk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# OAuth Providers (Better Auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Shipping API
SHIPPING_API_KEY=

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
